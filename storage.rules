rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Hunt cover images ───────────────────────────────────────────────────
    // Authenticated users can read. Only admin/backend can write.
    match /hunt-covers/{huntId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Checkpoint images ───────────────────────────────────────────────────
    // Authenticated users can read. Only admin/backend can write.
    match /checkpoint-images/{checkpointId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── User-uploaded photos ────────────────────────────────────────────────
    // A user can read/write files under their own path only.
    // Max file size: 5 MB. Only image content types allowed.
    match /user-photos/{userId}/{file} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Default deny ────────────────────────────────────────────────────────
    // Any path not matched above is denied.
  }
}
